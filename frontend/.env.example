# Backend API base URL.
NEXT_PUBLIC_API_URL=http://localhost:8001

# Clerk — route paths (non-sensitive, safe defaults shown).
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# Clerk — keys from your Clerk instance (dashboard.clerk.com).
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY is public (safe to ship to the browser);
# CLERK_SECRET_KEY is server-only — never expose it to the client.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
# CLERK_SECRET_KEY=sk_test_...
