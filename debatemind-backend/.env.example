DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5437/debatemind
SECRET_KEY=change-me-32-chars-minimum
# Used by the debate agents (extractor/opponent/judge) AND by Cognee's own
# internal LLM calls during cognify() — everything routes through OpenRouter.
OPENROUTER_API_KEY=sk-or-v1-...

# Models routed through OpenRouter (defaults shown).
FAST_MODEL=openai/gpt-4.1-mini
MAIN_MODEL=openai/gpt-4.1-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Cognee storage backend: "local" (default, self-hosted via the cognee-db
# service in docker-compose.yml) or "cloud" (skips local storage config,
# leaves Cognee's relational/vector/graph storage at its own defaults).
COGNEE_MODE=local

# Only relevant when COGNEE_MODE=local — defaults already match the cognee-db
# service in docker-compose.yml, override only if you changed that service.
COGNEE_DB_HOST=localhost
COGNEE_DB_PORT=5433
COGNEE_DB_NAME=cognee
COGNEE_DB_USERNAME=cognee
COGNEE_DB_PASSWORD=cognee

# Direct OpenAI API key — required for the voice agent (OpenAI Realtime API).
# OpenRouter does not support the Realtime API, so this must be a native OpenAI key (sk-...).
OPENAI_API_KEY=sk-...

# Neo4j graph DB — defaults match the neo4j service in docker-compose.yml.
# Open http://localhost:7474 in a browser to query the graph (neo4j / debatemind).
NEO4J_URL=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=debatemind

# Redis — used as both the Celery broker and result backend, matches the
# redis service in docker-compose.yml.
REDIS_URL=redis://localhost:6379/0

# Frontend origins allowed to call the API (JSON array).
CORS_ORIGINS=["http://localhost:3000"]

# JWT settings (defaults shown).
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# Clerk backend secret — used ONLY server-side to look up a user's email during
# SSO exchange. Never put this in the frontend (only NEXT_PUBLIC_* keys belong there).
# CLERK_SECRET_KEY=sk_test_...
# CLERK_JWKS_URL=https://<your-app>.clerk.accounts.dev/.well-known/jwks.json

# Security hardening (defaults shown).
RATE_LIMIT_PER_MINUTE=120   # per-client-IP request budget; 0 disables
ENABLE_HSTS=false           # set true only when served over HTTPS
